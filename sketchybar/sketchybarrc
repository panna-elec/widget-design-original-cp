#!/bin/bash
set -eu
BAR=/opt/homebrew/bin/sketchybar
BAR_DIR="$(cd "$(dirname "$0")" && pwd)"
FONT_DIR="$BAR_DIR/../cyberdeck.widget/lib/fonts"
"$BAR" --load-font "$FONT_DIR/Rajdhani-SemiBold.ttf"
# Only the left bracket is visible; the full-screen bar has no paint or border.
"$BAR" --bar position=top height=18 y_offset=28 margin=42 \
  color=0x00000000 border_width=0 corner_radius=0 \
  padding_left=0 padding_right=0 display=main topmost=off sticky=on shadow=off
"$BAR" --default icon.drawing=off label.font='Rajdhani:SemiBold:13.0' \
  label.color=0xffdcdce4 label.padding_left=8 label.padding_right=8 \
  padding_left=0 padding_right=0
"$BAR" --add item cyberdeck.brand left \
  --set cyberdeck.brand label='// CYBERDECK' label.color=0xfff75049 width=112 \
  --add item cyberdeck.power left \
  --set cyberdeck.power width=96 label.font='Hiragino Sans:W3:10.0' update_freq=30 script="\"$BAR_DIR/status.sh\" power" \
  --subscribe cyberdeck.power power_source_change system_woke \
  --add bracket cyberdeck.banner cyberdeck.brand cyberdeck.power \
  --set cyberdeck.banner background.color=0xf20e0e17 background.border_color=0x88f75049 \
    background.border_width=1 background.corner_radius=0 background.height=18 background.drawing=on
"$BAR_DIR/status.sh" power
